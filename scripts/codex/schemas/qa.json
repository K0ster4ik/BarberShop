{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exploratory QA report",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "checked", "bugs"],
  "properties": {
    "summary": { "type": "string", "description": "2-4 sentences in Russian." },
    "checked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "result", "notes"],
        "properties": {
          "scenario": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["passed", "failed", "blocked"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "bugs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "url", "steps", "expected", "actual"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "expected": { "type": "string" },
          "actual": { "type": "string" }
        }
      }
    }
  }
}
