# Скопируйте в .env и при необходимости поменяйте значения.

# Postgres для локальной разработки (docker-compose.dev.yml).
# По умолчанию порт 5433, чтобы не конфликтовать с локально установленным Postgres.
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=barbershop
POSTGRES_DB=barbershop
POSTGRES_PORT=5433

# Приложение
DATABASE_URL=postgresql://barbershop:barbershop@localhost:5433/barbershop
APP_URL=http://localhost:3000

# Секрет для подписи сессий, минимум 32 символа. Для продакшена сгенерируйте свой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Ограничения для общих демо-учёток: нельзя менять пароль и сбрасывать чужие сессии
DEMO_MODE=true

# Пароли демо-пользователей owner@demo.ru, admin@demo.ru, master@demo.ru (минимум 8 символов)
DEMO_OWNER_PASSWORD=owner-demo-2026
DEMO_ADMIN_PASSWORD=admin-demo-2026
DEMO_MASTER_PASSWORD=master-demo-2026

# Отдельная БД для интеграционных тестов (создаётся автоматически)
TEST_DATABASE_URL=postgresql://barbershop:barbershop@localhost:5433/barbershop_test
