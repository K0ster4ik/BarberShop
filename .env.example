# Скопируйте в .env и при необходимости поменяйте значения.

# Postgres для локальной разработки (docker-compose.dev.yml).
# По умолчанию порт 5433, чтобы не конфликтовать с локально установленным Postgres.
POSTGRES_USER=barbershop
POSTGRES_PASSWORD=barbershop
POSTGRES_DB=barbershop
POSTGRES_PORT=5433

# Приложение
DATABASE_URL=postgresql://barbershop:barbershop@localhost:5433/barbershop
APP_URL=http://localhost:3000
