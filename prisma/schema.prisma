// Схема БД: сайт барбершопа + CRM.
// Postgres + Prisma. Деньги хранятся в копейках (Int), время — в timestamptz.
// Описание сущностей и инвариантов: DESIGN.md, раздел 5.
//
// Чего Prisma не умеет выразить (exclusion constraint, CHECK-ограничения),
// лежит в ручных миграциях: booking_no_overlap, integrity_checks.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────── Перечисления ───────────────

enum Role {
  OWNER // владелец: всё, включая аналитику и деньги
  ADMIN // администратор: записи, клиенты, расписание
  MASTER // мастер: видит только свои записи
}

enum BookingStatus {
  PENDING // создана с сайта, ждёт подтверждения
  CONFIRMED // подтверждена
  COMPLETED // клиент пришёл, услуга оказана
  CANCELLED // отменена
  NO_SHOW // клиент не пришёл
}

enum BookingSource {
  WEBSITE // запись с сайта
  PHONE // по телефону, внёс админ
  WALK_IN // пришёл с улицы
}

enum DiscountKind {
  PERCENT // value — проценты, 1..100
  AMOUNT // value — сумма в копейках
}

enum SalonDiscountSource {
  PROMO_CODE
  CLIENT // постоянная скидка клиента
  MANUAL // ручная скидка админа
}

enum CancelledBy {
  CLIENT
  STAFF
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CANCELLED
}

// ─────────────── Персонал и доступ (Better Auth) ───────────────

// Учётные записи сотрудников (вход в админку/CRM).
// Клиенты аккаунтов не имеют — их узнаём по телефону.
// Поля name … updatedAt, а также Session / Account / Verification — формат Better Auth.
// ID генерирует Better Auth, поэтому без @default.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(ADMIN)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  sessions          Session[]
  accounts          Account[]
  master            Master? // если пользователь — мастер
  createdBookings   Booking[]
  createdPromotions MasterPromotion[]
  clientNotes       ClientNote[]
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// providerId = "credential" — вход по email и паролю; хэш пароля лежит в `password`.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// ─────────────── Мастера ───────────────

model Master {
  id        String   @id @default(cuid())
  userId    String?  @unique
  name      String
  title     String? // «Топ-барбер», «Колорист»
  bio       String?
  photoPath String? // путь внутри volume uploads, раздаётся Caddy
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0) // порядок вывода на сайте
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     MasterService[]
  promotions   MasterPromotion[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
  bookings     Booking[]
}

// ─────────────── Услуги ───────────────

model ServiceCategory {
  id        String @id @default(cuid())
  name      String @unique // «Стрижки», «Борода», «Комплексы», «Окрашивание»
  sortOrder Int    @default(0)

  services Service[]
}

model Service {
  id          String   @id @default(cuid())
  categoryId  String
  name        String // «Мужская стрижка», «Борода», «Камуфляж седины»
  description String?
  durationMin Int // рекомендуемая длительность, подставляется мастеру по умолчанию
  price       Int // рекомендуемая цена в копейках, подставляется мастеру по умолчанию
  bufferMin   Int? // уборка после услуги; null — salon.defaultBufferMin
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  category     ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  masters      MasterService[]
  promotions   MasterPromotion[]
  bookingItems BookingItem[]

  @@index([categoryId])
}

// Какие услуги делает мастер, по какой цене и за сколько.
// Цену и длительность задаёт сам мастер (или админ).
model MasterService {
  masterId    String
  serviceId   String
  price       Int // в копейках
  durationMin Int

  master  Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceId])
  @@index([serviceId])
}

// ─────────────── Скидки ───────────────

// Акция мастера: уменьшает цену услуги и выручку мастера (DESIGN.md, 7.3).
model MasterPromotion {
  id          String       @id @default(cuid())
  masterId    String
  serviceId   String? // null — на все услуги мастера
  title       String // «−20% на оформление бороды»
  kind        DiscountKind
  value       Int
  validFrom   DateTime?    @db.Timestamptz(3) // null — без ограничения
  validUntil  DateTime?    @db.Timestamptz(3) // полуинтервал [validFrom, validUntil)
  isActive    Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  master       Master        @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  bookingItems BookingItem[]

  @@index([masterId])
}

// Промокод салона: скидка на всю запись, не уменьшает выручку мастера.
// Число использований считается по неотменённым записям, отдельного счётчика нет.
model PromoCode {
  id         String       @id @default(cuid())
  code       String       @unique // в верхнем регистре
  kind       DiscountKind
  value      Int
  validFrom  DateTime?    @db.Timestamptz(3)
  validUntil DateTime?    @db.Timestamptz(3)
  maxUses    Int?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  bookings Booking[]
}

// ─────────────── Расписание ───────────────

// Рабочие часы по дням недели. Время — минуты от полуночи (600 = 10:00).
// Несколько интервалов в день = смена с перерывом.
model WorkingHours {
  id       String @id @default(cuid())
  masterId String
  weekday  Int // 0 = Пн ... 6 = Вс
  startMin Int
  endMin   Int

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId, weekday])
}

// Отпуска, больничные, разовые перерывы.
model TimeOff {
  id       String   @id @default(cuid())
  masterId String
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  reason   String?

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId, startsAt])
}

// ─────────────── Клиенты (CRM) ───────────────

model Client {
  id            String        @id @default(cuid())
  name          String
  phone         String        @unique // E.164: +79991234567
  email         String?
  birthday      DateTime?     @db.Date
  discountKind  DiscountKind? // постоянная скидка клиента
  discountValue Int?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  tags     ClientTag[]
  notes    ClientNote[]
  bookings Booking[]
}

// «VIP», «Опаздывает», «Борода» — для фильтров в CRM.
model Tag {
  id    String  @id @default(cuid())
  name  String  @unique
  color String? // имя цвета для бейджа: "amber", "sky" …

  clients ClientTag[]
}

model ClientTag {
  clientId String
  tagId    String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
}

// Заметки персонала о клиенте: «любит покороче, без разговоров».
model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String?
  text      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

// ─────────────── Записи ───────────────

model Booking {
  id               String        @id @default(cuid())
  clientId         String
  masterId         String
  startsAt         DateTime      @db.Timestamptz(3)
  endsAt           DateTime      @db.Timestamptz(3) // = startsAt + durationMin
  blockedUntil     DateTime      @db.Timestamptz(3) // = endsAt + bufferMin, по нему работает booking_no_overlap
  durationMin      Int // Σ BookingItem.durationMin, если не задана вручную
  isDurationManual Boolean       @default(false)
  bufferMin        Int
  status           BookingStatus @default(PENDING)
  source           BookingSource @default(WEBSITE)

  // Цены в копейках, фиксируются при записи (DESIGN.md, 7.3).
  subtotal            Int // Σ BookingItem.price — после скидок мастера
  salonDiscount       Int                  @default(0)
  salonDiscountSource SalonDiscountSource?
  promoCodeId         String?
  totalPrice          Int // subtotal − salonDiscount

  clientComment   String?
  cancelTokenHash String?      @unique // SHA-256 токена из ссылки на отмену
  confirmedAt     DateTime?    @db.Timestamptz(3)
  cancelledAt     DateTime?    @db.Timestamptz(3)
  cancelledBy     CancelledBy?
  deletedAt       DateTime?    @db.Timestamptz(3) // мягкое удаление
  createdById     String? // сотрудник, создавший запись; null — запись с сайта
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  master        Master         @relation(fields: [masterId], references: [id], onDelete: Restrict)
  promoCode     PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items         BookingItem[]
  payments      Payment[]
  notifications Notification[]

  @@index([masterId, startsAt]) // расписание мастера
  @@index([clientId, startsAt]) // история клиента
  @@index([status, startsAt]) // отчёты
}

// Услуги внутри записи. Название, цена и длительность копируются на момент записи,
// чтобы смена прайса не переписала историю и выручку.
model BookingItem {
  id             String  @id @default(cuid())
  bookingId      String
  serviceId      String
  serviceName    String
  basePrice      Int // цена мастера на момент записи
  masterDiscount Int     @default(0)
  price          Int // basePrice − masterDiscount, если не задана вручную
  isPriceManual  Boolean @default(false)
  durationMin    Int
  promotionId    String? // акция мастера, давшая скидку
  sortOrder      Int     @default(0)

  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  promotion MasterPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([serviceId])
}

// ─────────────── Оплаты ───────────────

// У записи может быть несколько оплат: часть наличными, часть картой.
model Payment {
  id        String        @id @default(cuid())
  bookingId String
  amount    Int // в копейках
  method    PaymentMethod
  paidAt    DateTime      @default(now()) @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([paidAt])
}

// ─────────────── Уведомления (outbox) ───────────────

// Создаётся в одной транзакции с записью или отменой; отправку повторяет cron (DESIGN.md, 9).
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  bookingId String
  sentAt    DateTime?        @db.Timestamptz(3)
  attempts  Int              @default(0)
  lastError String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([sentAt, createdAt])
}
